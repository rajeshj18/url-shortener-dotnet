<Project>
  <!-- Central package management: every NuGet version is set here, and only here. -->
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>
  <ItemGroup Label="Observability (ADR-0013)">
    <PackageVersion Include="OpenTelemetry.Extensions.Hosting" Version="1.20.1" />
    <PackageVersion Include="OpenTelemetry.Instrumentation.AspNetCore" Version="1.20.1" />
    <PackageVersion Include="OpenTelemetry.Instrumentation.Http" Version="1.20.1" />
    <PackageVersion Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" Version="1.20.1" />
  </ItemGroup>
  <ItemGroup Label="Persistence (ADR-0004)">
    <PackageVersion Include="Microsoft.EntityFrameworkCore" Version="8.0.32" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Design" Version="8.0.32" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Relational" Version="8.0.32" />
    <PackageVersion Include="Npgsql" Version="8.0.9" />
    <PackageVersion Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="8.0.11" />
  </ItemGroup>
  <ItemGroup Label="Analytics (ADR-0008, TSK-SIMPLE)">
    <PackageVersion Include="Confluent.Kafka" Version="2.16.0" />
  </ItemGroup>
  <ItemGroup Label="Resilience (LLD §6.7, TSK-11)">
    <!-- Polly v8 engine only. Microsoft.Extensions.Resilience is 10.x-only now and would pull .NET 10 assemblies. -->
    <PackageVersion Include="Polly.Core" Version="8.8.0" />
  </ItemGroup>
  <ItemGroup Label="API documentation (TSK-08)">
    <PackageVersion Include="Swashbuckle.AspNetCore" Version="10.2.3" />
  </ItemGroup>
  <ItemGroup Label="Tests">
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.11.0" />
    <PackageVersion Include="xunit" Version="2.9.3" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="4.0.1" />
    <PackageVersion Include="coverlet.collector" Version="10.1.0" />
    <!-- 7.x is the last Apache-2.0 release; 8.x is under a commercial licence. -->
    <PackageVersion Include="FluentAssertions" Version="7.2.2" />
    <PackageVersion Include="Microsoft.AspNetCore.Mvc.Testing" Version="8.0.32" />
    <PackageVersion Include="NetArchTest.Rules" Version="1.3.2" />
    <PackageVersion Include="Testcontainers.PostgreSql" Version="4.16.0" />
    <PackageVersion Include="Testcontainers.Redpanda" Version="4.16.0" />
    <PackageVersion Include="BenchmarkDotNet" Version="0.15.8" />
  </ItemGroup>
</Project>
