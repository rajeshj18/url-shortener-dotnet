    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Newtonsoft.Json" /> <!-- PROOF ONLY (TSK-04 AC3f): known-vulnerable version -->
