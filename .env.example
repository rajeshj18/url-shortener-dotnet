# Local development only. Copy to .env (git-ignored) before running: cp .env.example .env
# These are throwaway values for a local container; never reuse them anywhere else (ADR-0011).
POSTGRES_DB=links
POSTGRES_USER=postgres_bootstrap
POSTGRES_PASSWORD=change-me-local-only

# Application database roles (TSK-06), created on first start by docker/postgres/init/01-roles.sh.
LINKS_MIGRATOR_PASSWORD=change-me-local-only-migrator
LINKS_API_PASSWORD=change-me-local-only-api
LINKS_REDIRECT_PASSWORD=change-me-local-only-redirect
ANALYTICS_WORKER_PASSWORD=change-me-local-only-worker

# Short-code Feistel passphrase (TSK-07, ADR-0005): at least 32 characters. In real environments it comes from the
# secret store, is backed up, and NEVER changes once codes exist (changing it would make new codes collide with old ones).
SHORTCODE_FEISTEL_KEY=local-only-feistel-passphrase-change-me

# Local Api client (TSK-08): SHA-256 of the dev key `local-dev-api-key-change-me` shown in the README. Throwaway;
# real clients' hashes come from the secret store, and keys themselves are never configured anywhere.
DEV_CALLER_HASH=dbfa6e71cf9164ee80524dd80b61c77d644fe0d937258cbb6c280a1ce36700fe
